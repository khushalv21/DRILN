<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Scan Report — {{ target }}</title>
<style>
  :root {
    --bg: #ffffff;
    --bg-alt: #f6f7f9;
    --fg: #1a1c20;
    --fg-dim: #5b616e;
    --border: #e2e5ea;
    --accent: #b3261e;
    --critical: #b3261e;
    --high: #c2540c;
    --medium: #a8790a;
    --low: #1c6e3f;
    --info: #5b616e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14161a;
      --bg-alt: #1c1f25;
      --fg: #e9eaed;
      --fg-dim: #9aa0ac;
      --border: #2c313a;
      --accent: #ff6b60;
      --critical: #ff6b60;
      --high: #ff9d52;
      --medium: #e0b23c;
      --low: #4ade80;
      --info: #9aa0ac;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    line-height: 1.55;
  }
  .wrap { max-width: 860px; margin: 0 auto; padding: 40px 24px 80px; }
  h1 { font-size: 1.7rem; margin: 0 0 4px; }
  h2 {
    font-size: 1.15rem;
    margin: 40px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  h3 { font-size: 1rem; margin: 24px 0 8px; }
  .meta { color: var(--fg-dim); font-size: 0.92rem; }
  .badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .badge.critical { background: color-mix(in srgb, var(--critical) 18%, transparent); color: var(--critical); }
  .badge.high { background: color-mix(in srgb, var(--high) 18%, transparent); color: var(--high); }
  .badge.medium { background: color-mix(in srgb, var(--medium) 18%, transparent); color: var(--medium); }
  .badge.low { background: color-mix(in srgb, var(--low) 18%, transparent); color: var(--low); }
  .badge.info { background: color-mix(in srgb, var(--info) 18%, transparent); color: var(--info); }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 0.92rem; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); }
  th { color: var(--fg-dim); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .risk-score {
    display: flex;
    align-items: baseline;
    gap: 10px;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 20px;
    margin: 12px 0;
  }
  .risk-score .num { font-size: 2.2rem; font-weight: 700; }
  .finding {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 18px;
    margin: 12px 0;
    background: var(--bg-alt);
  }
  .finding-title { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .finding-title strong { font-size: 1rem; }
  .where { color: var(--fg-dim); font-size: 0.88rem; }
  .ai-summary {
    white-space: pre-wrap;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 20px;
  }
  details { margin-top: 12px; }
  summary { cursor: pointer; color: var(--fg-dim); font-size: 0.9rem; }
  code {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 0.85em;
  }
  footer { margin-top: 48px; color: var(--fg-dim); font-size: 0.82rem; text-align: center; }
</style>
</head>
<body>
<div class="wrap">

  <h1>Security Scan Report</h1>
  <p class="meta">
    <strong>Target:</strong> {{ target }} &nbsp;·&nbsp;
    <strong>Scanned:</strong> {{ started_at.strftime('%B %d, %Y at %I:%M %p') if started_at else 'N/A' }} UTC
    {% if scan_duration %}&nbsp;·&nbsp; <strong>Duration:</strong> {{ scan_duration }}{% endif %}
  </p>

  {% if risk_summary %}
  <div class="risk-score">
    <span class="num">{{ risk_summary.score | int }}<span style="font-size:1rem;color:var(--fg-dim)">/100</span></span>
    <span class="badge {{ risk_summary.label }}">{{ risk_summary.label | upper }}</span>
  </div>
  {% endif %}

  <h2>What We Found</h2>
  {% if total_findings == 0 %}
  <p>We scanned your system and found <strong>no issues</strong>. Everything looks clean.</p>
  {% else %}
  <p>We scanned your system and found <strong>{{ total_findings }}</strong> thing{{ "s" if total_findings != 1 else "" }} worth knowing about.</p>
  <table>
    <thead><tr><th>What</th><th>Risk</th><th>Where</th></tr></thead>
    <tbody>
    {% for f in findings %}
      <tr>
        <td>{{ f.title }}</td>
        <td><span class="badge {{ f.severity }}">{{ f.severity | upper }}</span></td>
        <td class="where">{{ f.host }}{% if f.port %}:{{ f.port }}{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if correlations %}
  <h2>Correlated Findings</h2>
  <ul>
  {% for g in correlations %}
    <li><strong>{{ g.relationship | replace('_', ' ') | capitalize }}</strong>: {{ g.summary }} <span class="where">({{ g.finding_ids | length }} findings)</span></li>
  {% endfor %}
  </ul>
  {% endif %}

  {% if tech_profile and tech_profile.technologies %}
  <h2>Technology Profile</h2>
  <table>
    <thead><tr><th>Technology</th><th>Version</th><th>Category</th><th>Confidence</th></tr></thead>
    <tbody>
    {% for t in tech_profile.technologies %}
      <tr>
        <td><strong>{{ t.name }}</strong></td>
        <td>{{ t.version or "—" }}</td>
        <td>{{ t.category }}</td>
        <td>{{ "%.0f" | format(t.confidence * 100) }}%</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if ai_summary and not ai_summary.startswith("AI analysis not configured") and not ai_summary.startswith("_AI analysis unavailable") and not ai_summary.startswith("_AI analysis skipped") %}
  <h2>AI Analysis</h2>
  <div class="ai-summary">{{ ai_summary }}</div>
  {% endif %}

  <h2>Details</h2>
  {% for sev in ["critical", "high", "medium", "low", "info"] %}
    {% set sev_findings = findings | selectattr("severity", "equalto", sev) | list %}
    {% for f in sev_findings %}
    <div class="finding">
      <div class="finding-title">
        <span class="badge {{ f.severity }}">{{ f.severity | upper }}</span>
        <strong>{{ f.title }}</strong>
      </div>
      {% if f.description %}<p>{{ f.description }}</p>{% endif %}
      <p class="where">
        {% if f.host %}{{ f.host }}{% if f.port %}:{{ f.port }}{% endif %}{% endif %}
        {% if f.service %} &nbsp;·&nbsp; {{ f.service }}{% endif %}
      </p>
    </div>
    {% endfor %}
  {% endfor %}

  {% if recommendations %}
  <h2>What We Recommend</h2>
  <ol>
  {% for rec in recommendations %}
    <li><strong>{{ rec.title }}</strong> — {{ rec.rationale }}</li>
  {% endfor %}
  </ol>
  {% endif %}

  <h2>Technical Details</h2>
  <details>
    <summary>Click to expand (for security professionals)</summary>
    <table>
      <thead><tr><th>Tool</th><th>Status</th><th>Duration</th><th>Findings</th></tr></thead>
      <tbody>
      {% for tr in tool_runs %}
        <tr>
          <td>{{ tr.tool_name }}</td>
          <td>{{ tr.status }}</td>
          <td>{{ "%.1f" | format(tr.duration_seconds) if tr.duration_seconds else "—" }}s</td>
          <td>{{ tr.finding_count }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="meta">
      <strong>Scan ID:</strong> <code>{{ scan_id }}</code> &nbsp;·&nbsp;
      <strong>Scan Type:</strong> {{ scan_type }} &nbsp;·&nbsp;
      <strong>Status:</strong> {{ status }}
    </p>
  </details>

  <footer>Report generated by Driln &nbsp;·&nbsp; {{ generated_at.strftime('%Y-%m-%d %H:%M UTC') if generated_at else "" }}</footer>

</div>
</body>
</html>
